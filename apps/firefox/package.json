{
  "name": "@goreecloud/vault-firefox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "lint:extension": "web-ext lint --source-dir dist --output json",
    "package": "web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "test": "vitest run src",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "web-ext": "10.8.0"
  }
}
